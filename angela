  dist = {v: float('inf') for v in graph}  #temporarily making every distance infinite
  	dist[source] = c[source]  #the distance to source is just its own cost   
pq = [(dist[source], source)]#priority queue (distance, vertex)

As long as pq is not empty:
	current_dist = heapq.heappop(pq)

